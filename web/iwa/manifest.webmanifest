{
  "id": "/",
  "name": "WasmNUX Direct Sockets probe",
  "version": "0.0.1",
  "start_url": "/",
  "display": "standalone",
  "icons": [
    {
      "src": "/icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "permissions_policy": {
    "direct-sockets": [
      "self"
    ],
    "cross-origin-isolated": [
      "self"
    ],
    "direct-sockets-private": [
      "self"
    ],
    "local-network": [
      "self"
    ],
    "loopback-network": [
      "self"
    ]
  },
  "scope": "/"
}
